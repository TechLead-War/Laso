---

<footer class="border-t border-black/[0.06] bg-white">
  <div class="max-w-5xl mx-auto px-5 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <!-- Features -->
      <div>
        <p class="text-[12px] font-semibold text-[#1d1d1f] uppercase tracking-wider mb-3">Features</p>
        <ul class="space-y-2">
          <li><a href="/recovery-score" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Recovery Score</a></li>
          <li><a href="/strain-tracking" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Strain Tracking</a></li>
          <li><a href="/sleep-coaching" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Sleep Coaching</a></li>
          <li><a href="/vitality-age" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Vitality Age</a></li>
          <li><a href="/stress-monitor" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Stress Monitor</a></li>
          <li><a href="/illness-detection" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Wellness Detection</a></li>
          <li><a href="/cycle-tracking" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Cycle Tracking</a></li>
        </ul>
      </div>

      <!-- Compare -->
      <div>
        <p class="text-[12px] font-semibold text-[#1d1d1f] uppercase tracking-wider mb-3">Compare</p>
        <ul class="space-y-2">
          <li><a href="/vs-whoop" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Laso vs WHOOP</a></li>
          <li><a href="/vs-oura" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Laso vs Oura</a></li>
          <li><a href="/devices" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Compatible Devices</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <p class="text-[12px] font-semibold text-[#1d1d1f] uppercase tracking-wider mb-3">Resources</p>
        <ul class="space-y-2">
          <li><a href="/faq" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">FAQ</a></li>
          <li><a href="/about" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">About</a></li>
          <li><a href="https://www.instagram.com/healthlaso/" target="_blank" rel="noopener" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Instagram</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-[12px] font-semibold text-[#1d1d1f] uppercase tracking-wider mb-3">Legal</p>
        <ul class="space-y-2">
          <li><a href="/privacy" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-[13px] text-[#6e6e73] hover:text-[#1d1d1f] transition-colors">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-black/[0.06] pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-[12px] text-[#6e6e73]">&copy; {new Date().getFullYear()} Laso Health. All rights reserved. Not medical advice.</p>
      <div class="flex items-center gap-4">
        <a href="https://apps.apple.com/app/id6762501313" target="_blank" rel="noopener" class="text-[#6e6e73] hover:text-[#1d1d1f] transition-colors" aria-label="Download Laso on the App Store">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        </a>
        <a href="https://www.instagram.com/healthlaso/" target="_blank" rel="noopener" class="text-[#6e6e73] hover:text-[#1d1d1f] transition-colors" aria-label="Follow Laso on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
