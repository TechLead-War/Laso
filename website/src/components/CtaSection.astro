---
interface Props {
  heading?: string
  subheading?: string
}
const { heading = "Try Laso free for 7 days.", subheading = "You already have the wearable. Laso does the rest." } = Astro.props
---

<section class="py-16 md:py-24 px-5 bg-[#f5f5f7]">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-[#1d1d1f] text-balance">
      {heading}
    </h2>
    <p class="mt-3 text-[15px] text-[#6e6e73] max-w-lg mx-auto">
      {subheading}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-3">
      <a href="https://apps.apple.com/in/app/laso/id6762501313" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#1d1d1f] text-white font-medium rounded-full px-7 py-3 min-h-[48px] text-[15px] hover:bg-black transition-colors">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        Download on the App Store
      </a>
      <a href="https://www.instagram.com/healthlaso/" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-white text-[#1d1d1f] font-medium rounded-full px-6 py-3 min-h-[48px] text-[15px] border border-gray-200 hover:border-[#1d1d1f] transition-colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        Follow on Instagram
      </a>
    </div>
    <p class="mt-3 text-[13px] text-[#6e6e73]/60">Free 7-day trial. iPhone &amp; Apple Watch.</p>
  </div>
</section>
