const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Sleep Debt: What It Is, How It Accumulates, and How to Pay It Off",
    "description": "Sleep debt is the gap between the sleep you need and the sleep you get. Learn how it builds up, its effects on health and performance, and realistic strategies to recover.",
    "datePublished": "2026-04-11",
    "dateModified": "2026-04-11",
    "author": {
      "@type": "Organization",
      "name": "Laso Health"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Laso Health",
      "logo": {
        "@type": "ImageObject",
        "url": "https://lasohealth.fit/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://lasohealth.fit/learn/sleep-debt"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you catch up on sleep debt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Short-term sleep debt (a few days) can be recovered by adding 1 to 2 extra hours of sleep per night over several days. Chronic sleep debt accumulated over weeks or months takes significantly longer to recover from and may have lasting effects on metabolic health. Weekend sleep-ins help but do not fully compensate for weekday losses."
        }
      },
      {
        "@type": "Question",
        "name": "How much sleep debt is too much?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Research from the University of Pennsylvania found that sleeping only 6 hours per night for 2 weeks produced cognitive impairment equivalent to going 2 full nights without sleep. Even small daily deficits of 1 to 2 hours add up quickly and begin to affect reaction time, memory, and immune function within a few days."
        }
      },
      {
        "@type": "Question",
        "name": "Does napping erase sleep debt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A short recovery nap of 20 to 30 minutes can temporarily boost alertness and cognitive performance, but it does not erase accumulated sleep debt. Naps are best used as a supplement to consistent nighttime sleep, not as a replacement for it."
        }
      }
    ]
