  </div>
  <script>
    // ── Analytics helpers ──
    function trackEvent(name: string, params?: Record<string, string | number>) {
      if (typeof window.gtag === 'function') {
        window.gtag('event', name, params)
      }
    }

    function trackMeta(event: string, params?: Record<string, string | number | boolean>) {
      if (typeof window.fbq === 'function') {
        const standard = ['Lead', 'ViewContent', 'CompleteRegistration', 'PageView', 'AddToWishlist']
        if (standard.includes(event)) {
          window.fbq('track', event, params)
        } else {
          window.fbq('trackCustom', event, params)
        }
      }
    }

    // ── UTM + attribution capture ──
    const urlParams = new URLSearchParams(window.location.search)
    const utmParams: Record<string, string> = {}
    for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) {
      const val = urlParams.get(key)
      if (val) utmParams[key] = val
    }
    const fbclid = urlParams.get('fbclid')
    if (fbclid) utmParams['fbclid'] = fbclid
    const gclid = urlParams.get('gclid')
    if (gclid) utmParams['gclid'] = gclid

    // ── Signup counter ──
    const SIGNUP_API_BASE = 'https://us-central1-laso-health-v1.cloudfunctions.net'
    const SIGNUP_COUNT_URL = `${SIGNUP_API_BASE}/getSignupCount`
    const SIGNUP_SUBMIT_URL = `${SIGNUP_API_BASE}/earlyAccessSignup`
    const SIGNED_UP_KEY = 'laso_signed_up_v2'
    let currentSignupCount = 0

    async function fetchSignupCount(): Promise<number | null> {
      try {
        const res = await fetch(SIGNUP_COUNT_URL, { method: 'GET' })
        if (res.ok) {
          const data = await res.json()
          const rawCount = Number(data?.count)
          if (Number.isFinite(rawCount) && rawCount >= 0) return Math.floor(rawCount)
        }
      } catch { /* silent */ }

      return null
    }

    function updateCounterDisplay(count: number) {
      currentSignupCount = count
      document.querySelectorAll('.signup-counter').forEach(el => {
        el.textContent = String(count)
      })
    }

    async function refreshSignupCount() {
      const count = await fetchSignupCount()
      if (count !== null) updateCounterDisplay(count)
    }

    refreshSignupCount()
    window.setInterval(refreshSignupCount, 15000)

    // ── Early access form handler ──
    async function handleSignup(form: HTMLFormElement) {
      const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement | null
      const email = emailInput?.value?.trim()
      if (!email) return

      const emailDomain = email.split('@')[1] ?? 'unknown'
      const formId = form.id === 'hero-form' ? 'hero' : 'early_access_cta'

      // GA4
      trackEvent('early_access_signup', { email_domain: emailDomain, form_location: formId, ...utmParams })

      // Meta Pixel — Lead (standard event, used for ad optimization + lookalike audiences)
      trackMeta('Lead', {
        content_name: 'early_access',
        content_category: 'signup',
        value: 0,
        currency: 'USD',
      })
      // Also fire AddToWishlist for secondary optimization signal
      trackMeta('AddToWishlist', {
        content_name: 'laso_app',
        content_category: formId,
      })

      localStorage.setItem(SIGNED_UP_KEY, 'true')
      // Backward compatibility for prior key in browsers with old sessions.
      localStorage.setItem('laso_signed_up', 'true')

      // Send signup to backend so response includes the latest global count
      let submittedCount: number | null = null
      try {
        const payload: Record<string, string> = {
          email,
          source: utmParams['utm_source'] || 'direct',
          medium: utmParams['utm_medium'] || 'none',
          campaign: utmParams['utm_campaign'] || '',
          referrer: document.referrer || 'none',
          landing_page: window.location.pathname,
          form_location: formId,
          user_agent: navigator.userAgent,
          screen_size: `${screen.width}x${screen.height}`,
          locale: navigator.language || '',
        }
        if (utmParams['utm_content']) payload['utm_content'] = utmParams['utm_content']
        if (utmParams['utm_term']) payload['utm_term'] = utmParams['utm_term']
        if (utmParams['fbclid']) payload['fbclid'] = utmParams['fbclid']
        if (utmParams['gclid']) payload['gclid'] = utmParams['gclid']

        const res = await fetch(SIGNUP_SUBMIT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        if (res.ok) {
          const data = await res.json()
          const rawCount = Number(data?.count)
          if (Number.isFinite(rawCount) && rawCount >= 0) {
            submittedCount = Math.floor(rawCount)
          }
        }
      } catch {
        // Silent fail
      }

      // Refresh count from backend after signup
      if (submittedCount !== null) {
        updateCounterDisplay(submittedCount)
      } else {
        const latestCount = await fetchSignupCount()
        if (latestCount !== null) updateCounterDisplay(latestCount)
        else updateCounterDisplay(currentSignupCount + 1)
      }

      // Show success state
      const success = form.parentElement?.querySelector('.hero-success, .ea-success')
      if (success) success.classList.remove('hidden')
      if (emailInput) emailInput.value = ''
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (btn) {
        btn.textContent = "You're in!"
        btn.disabled = true
        btn.classList.add('opacity-60')
      }
    }

    document.querySelectorAll<HTMLFormElement>('#hero-form, #early-access-form').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault()
        handleSignup(form)
      })
    })

    // ── Restore signed-up state on refresh ──
    const hasSignedUp = localStorage.getItem(SIGNED_UP_KEY) === 'true' || localStorage.getItem('laso_signed_up') === 'true'
    if (hasSignedUp) {
      document.querySelectorAll<HTMLFormElement>('#hero-form, #early-access-form').forEach((form) => {
        const emailInput = form.querySelector('input[type="email"]') as HTMLInputElement | null
        if (emailInput) emailInput.value = ''
        const success = form.parentElement?.querySelector('.hero-success, .ea-success')
        if (success) success.classList.remove('hidden')
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
        if (btn) {
          btn.textContent = "You're in!"
          btn.disabled = true
          btn.classList.add('opacity-60')
        }
      })
    }

    // ── Form interaction tracking (intent signals for Meta optimization) ──
    let formFocused = false
    let formStarted = false
    document.querySelectorAll<HTMLInputElement>('input[type="email"]').forEach(input => {
      input.addEventListener('focus', () => {
        if (!formFocused) {
          formFocused = true
          trackEvent('form_focus', { form: 'early_access' })
          trackMeta('FormInteraction', { action: 'focus' })
        }
      })
      input.addEventListener('input', () => {
        if (!formStarted) {
          formStarted = true
          trackEvent('form_start', { form: 'early_access' })
          trackMeta('FormInteraction', { action: 'typing' })
        }
      })
    })

    // ── CTA click tracking ──
    document.querySelectorAll('a[href="#early-access"]').forEach(el => {
      el.addEventListener('click', () => {
        trackEvent('cta_click', { button: 'get_early_access_nav' })
        trackMeta('CTAClick', { button: 'get_early_access_nav' })
      })
    })

    // ── Section reveal + tracking ──
    const viewedSections = new Set<string>()
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const section = entry.target.getAttribute('data-section')
            if (section && !viewedSections.has(section)) {
              viewedSections.add(section)
              trackEvent('section_view', { section })
              trackMeta('ViewContent', { content_name: section, content_category: 'section' })
            }
          }
        })
      },
      { threshold: 0.15 },
    )

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible')
            revealObserver.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 },
    )

    document.querySelectorAll('[data-section]').forEach((s) => sectionObserver.observe(s))
    document.querySelectorAll('.section-reveal').forEach((el) => revealObserver.observe(el))

    // ── Score counter animation ──
    const counter = document.querySelector('.score-counter') as HTMLElement | null
    if (counter) {
      const target = parseInt(counter.dataset.target ?? '0', 10)
      let started = false
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true
            const duration = 1600
            const start = performance.now()
            const step = (now: number) => {
              const elapsed = now - start
              const progress = Math.min(elapsed / duration, 1)
              const eased = 1 - Math.pow(1 - progress, 3)
              counter.textContent = String(Math.round(eased * target))
              if (progress < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
            counterObserver.disconnect()
          }
        })
      }, { threshold: 0.5 })
      counterObserver.observe(counter)
    }

    // ── Scroll depth ──
    const scrollFired = new Set<number>()
    window.addEventListener('scroll', () => {
      const pct = Math.round(((window.scrollY + window.innerHeight) / document.body.scrollHeight) * 100)
      for (const t of [25, 50, 75, 100]) {
        if (pct >= t && !scrollFired.has(t)) {
          scrollFired.add(t)
          trackEvent('scroll_depth', { depth: t })
          trackMeta('ScrollDepth', { depth: t })
        }
      }
    }, { passive: true })

    // ── Time on page ──
    const startTime = Date.now()
    window.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        const duration = Math.round((Date.now() - startTime) / 1000)
        trackEvent('time_on_page', { duration_sec: duration })
        trackMeta('TimeOnPage', { seconds: duration })
      }
    })
  </script>
</Base>
