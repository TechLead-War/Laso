---
import Base from '../layouts/Base.astro'
import '../styles/globals.css'
---

<Base
  title="Laso — Your Health, Understood"
  description="One intelligent score from 50+ health metrics. Laso turns your Apple Watch data into clear, personal insights — all on device, all private."
>
  <div class="min-h-screen bg-white">

    <!-- ════════ NAV ════════ -->
    <nav aria-label="Main navigation" class="nav-blur fixed top-0 inset-x-0 z-50 border-b border-gray-100/60">
      <div class="max-w-6xl mx-auto px-5 h-12 flex items-center justify-between">
        <a href="#" class="text-[17px] font-semibold tracking-tight text-apple-dark">Laso</a>
        <div class="hidden md:flex items-center gap-7">
          <a href="#features" class="text-xs font-medium text-apple-secondary hover:text-apple-dark transition-colors">Features</a>
          <a href="#journey" class="text-xs font-medium text-apple-secondary hover:text-apple-dark transition-colors">How It Works</a>
          <a href="#devices" class="text-xs font-medium text-apple-secondary hover:text-apple-dark transition-colors">Devices</a>
          <a href="#pricing" class="text-xs font-medium text-apple-secondary hover:text-apple-dark transition-colors">Pricing</a>
        </div>
        <button data-download="nav" class="bg-apple-dark text-white text-xs font-medium rounded-full px-4 py-1.5 hover:bg-black transition-colors cursor-pointer">
          Download
        </button>
      </div>
    </nav>

    <!-- ════════ HERO ════════ -->
    <section data-section="hero" class="hero-gradient pt-32 pb-20 md:pt-44 md:pb-32 px-5 text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight text-apple-dark text-balance max-w-3xl mx-auto leading-[1.08]">
        Your health, <span class="gradient-text">understood.</span>
      </h1>
      <p class="mt-5 text-lg md:text-xl text-apple-secondary max-w-xl mx-auto text-balance leading-relaxed">
        One intelligent score from 50+ metrics. Not 43 numbers you'll never read.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button data-download="hero" class="inline-flex items-center gap-2.5 bg-apple-dark text-white font-medium rounded-full px-7 py-3.5 text-[15px] hover:bg-black transition-colors active:scale-[0.97] cursor-pointer">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11Z"/>
          </svg>
          Download for iOS
        </button>
        <span class="text-sm text-apple-secondary">Free &middot; No account needed</span>
      </div>

      <!-- Score hero -->
      <div class="mt-14 md:mt-20 flex justify-center">
        <div class="score-showcase">
          <!-- Ambient glow -->
          <div class="score-glow" aria-hidden="true"></div>

          <!-- Main ring -->
          <div class="relative w-52 h-52 sm:w-64 sm:h-64 md:w-72 md:h-72 mx-auto">
            <svg viewBox="0 0 280 280" class="w-full h-full" aria-hidden="true">
              <defs>
                <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0071e3"/>
                  <stop offset="40%" stop-color="#34d399"/>
                  <stop offset="100%" stop-color="#06b6d4"/>
                </linearGradient>
                <filter id="ring-glow">
                  <feGaussianBlur stdDeviation="6" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <!-- Track -->
              <circle cx="140" cy="140" r="120" fill="none" stroke="#e8e8ed" stroke-width="12"/>
              <!-- Progress arc: 87% of 2πr = 87% of 753.98 ≈ 656 filled, offset = 753.98 - 656 = 98 -->
              <circle cx="140" cy="140" r="120" fill="none" stroke="url(#ring-grad)" stroke-width="12"
                stroke-linecap="round"
                stroke-dasharray="753.98"
                stroke-dashoffset="98"
                filter="url(#ring-glow)"
                class="origin-center -rotate-90 score-ring-animate"/>
            </svg>
            <!-- Number overlay -->
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="score-counter text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight text-apple-dark" data-target="87">0</span>
              <span class="text-xs sm:text-sm font-medium text-apple-secondary mt-1">out of 100</span>
            </div>
          </div>

          <!-- Grade badge -->
          <div class="mt-5 flex justify-center">
            <div class="inline-flex items-center gap-2 bg-emerald-50 border border-emerald-200/60 rounded-full px-5 py-2">
              <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
              <span class="text-sm font-semibold text-emerald-700">Grade A</span>
              <span class="text-sm text-emerald-600/70">&middot;</span>
              <span class="text-sm text-emerald-600">Very Good</span>
            </div>
          </div>

          <!-- Category mini-scores -->
          <div class="mt-8 flex flex-wrap justify-center gap-3 max-w-md mx-auto">
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Heart 91</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-indigo-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Sleep 84</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Activity 88</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-orange-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Body 82</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-cyan-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Respiratory 90</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-purple-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Mindfulness 79</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/80 backdrop-blur-sm border border-gray-100 rounded-full px-3 py-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-teal-500"></div>
              <span class="text-[11px] font-medium text-apple-dark">Mobility 85</span>
            </div>
          </div>

          <p class="mt-6 text-xs text-apple-secondary/60">Sample data &mdash; your score is calculated from your own metrics</p>
        </div>
      </div>
    </section>

    <!-- ════════ VALUES ════════ -->
    <section data-section="values" class="bg-apple-gray py-20 md:py-28 px-5">
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6 md:gap-8">

        <div class="section-reveal bg-white rounded-2xl p-7 md:p-8">
          <div class="w-11 h-11 rounded-xl bg-apple-gray flex items-center justify-center text-apple-dark mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-apple-dark">Private by Design</h3>
          <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Every calculation runs on your iPhone. Your health data never leaves your device. We can't see it even if we wanted to.</p>
        </div>

        <div class="section-reveal bg-white rounded-2xl p-7 md:p-8" style="transition-delay:100ms">
          <div class="w-11 h-11 rounded-xl bg-apple-gray flex items-center justify-center text-apple-dark mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-apple-dark">Personal, Not Generic</h3>
          <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Your baselines. Your patterns. Insights come from your body's data &mdash; not population averages from a textbook.</p>
        </div>

        <div class="section-reveal bg-white rounded-2xl p-7 md:p-8" style="transition-delay:200ms">
          <div class="w-11 h-11 rounded-xl bg-apple-gray flex items-center justify-center text-apple-dark mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-apple-dark">Respects Your Time</h3>
          <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Glance in the morning, understand your day. Weekly reviews take ten seconds. No streaks. No guilt. Just clarity.</p>
        </div>

      </div>
    </section>

    <!-- ════════ FEATURES ════════ -->
    <section id="features" data-section="features" class="py-20 md:py-28 px-5">
      <div class="max-w-5xl mx-auto">
        <h2 class="section-reveal text-3xl md:text-4xl font-semibold tracking-tight text-apple-dark text-center text-balance">
          Everything your watch measures.<br class="hidden sm:block"/> Finally made useful.
        </h2>
        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">

          <div class="section-reveal feature-card border border-gray-100">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Health Score</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">One number that tells you how you're doing. Not 43 metrics and a guessing game.</p>
          </div>

          <div class="section-reveal feature-card border border-gray-100" style="transition-delay:80ms">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Personal Insights</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">&ldquo;Your resting heart rate is 6&thinsp;bpm lower on days you walk 8,000+ steps.&rdquo; Only your data reveals this.</p>
          </div>

          <div class="section-reveal feature-card border border-gray-100" style="transition-delay:160ms">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-blue-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Sleep Analysis</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Deep, REM, Core, Awake &mdash; see exactly what happened while you slept and what moves the needle.</p>
          </div>

          <div class="section-reveal feature-card border border-gray-100" style="transition-delay:240ms">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-red-500 to-rose-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Live Vitals</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Real-time heart rate, blood oxygen, respiratory rate &mdash; streaming from your wrist as it happens.</p>
          </div>

          <div class="section-reveal feature-card border border-gray-100" style="transition-delay:320ms">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Risk Detection</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Early warnings based on your trends. See what's shifting before it becomes a problem.</p>
          </div>

          <div class="section-reveal feature-card border border-gray-100" style="transition-delay:400ms">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-green-400 flex items-center justify-center mb-5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7 text-white">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
              </svg>
            </div>
            <h3 class="text-[17px] font-semibold text-apple-dark">Weekly Reviews</h3>
            <p class="mt-2 text-[15px] text-apple-secondary leading-relaxed">Score up? Down? One win. One thing to watch. Ten seconds and you know exactly where you stand.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ════════ JOURNEY ════════ -->
    <section id="journey" data-section="journey" class="bg-apple-gray py-20 md:py-28 px-5">
      <div class="max-w-3xl mx-auto">
        <h2 class="section-reveal text-3xl md:text-4xl font-semibold tracking-tight text-apple-dark text-center text-balance">
          30 days from data to understanding.
        </h2>
        <p class="section-reveal mt-4 text-center text-apple-secondary text-[15px] md:text-base max-w-lg mx-auto">
          You won't change your routine. You'll just start seeing what was always there.
        </p>
        <div class="mt-14 space-y-0">

          <div class="section-reveal flex gap-5 md:gap-7">
            <div class="flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-apple-blue shrink-0 mt-1.5"></div>
              <div class="w-px flex-1 bg-gray-200 my-1"></div>
            </div>
            <div class="pb-10">
              <span class="text-xs font-semibold text-apple-blue uppercase tracking-wider">Day 0</span>
              <h3 class="mt-1 text-lg font-semibold text-apple-dark">See yourself clearly</h3>
              <p class="mt-1.5 text-[15px] text-apple-secondary leading-relaxed max-w-md">Download Laso. For the first time your health has a shape &mdash; one number, and where it comes from.</p>
            </div>
          </div>

          <div class="section-reveal flex gap-5 md:gap-7" style="transition-delay:100ms">
            <div class="flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-apple-blue shrink-0 mt-1.5"></div>
              <div class="w-px flex-1 bg-gray-200 my-1"></div>
            </div>
            <div class="pb-10">
              <span class="text-xs font-semibold text-apple-blue uppercase tracking-wider">Day 7</span>
              <h3 class="mt-1 text-lg font-semibold text-apple-dark">Cause and effect</h3>
              <p class="mt-1.5 text-[15px] text-apple-secondary leading-relaxed max-w-md">Your first weekly review: what improved, what slipped. You start seeing the connection between your choices and your score.</p>
            </div>
          </div>

          <div class="section-reveal flex gap-5 md:gap-7" style="transition-delay:200ms">
            <div class="flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-apple-blue shrink-0 mt-1.5"></div>
              <div class="w-px flex-1 bg-gray-200 my-1"></div>
            </div>
            <div class="pb-10">
              <span class="text-xs font-semibold text-apple-blue uppercase tracking-wider">Day 14</span>
              <h3 class="mt-1 text-lg font-semibold text-apple-dark">A personal discovery</h3>
              <p class="mt-1.5 text-[15px] text-apple-secondary leading-relaxed max-w-md">An insight surfaces that no article could have told you. A pattern unique to your body, revealed by your own data.</p>
            </div>
          </div>

          <div class="section-reveal flex gap-5 md:gap-7" style="transition-delay:300ms">
            <div class="flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-apple-blue shrink-0 mt-1.5"></div>
            </div>
            <div class="pb-10">
              <span class="text-xs font-semibold text-apple-blue uppercase tracking-wider">Day 30</span>
              <h3 class="mt-1 text-lg font-semibold text-apple-dark">Quiet confidence</h3>
              <p class="mt-1.5 text-[15px] text-apple-secondary leading-relaxed max-w-md">You know what's normal. You know what's changing. You know what works for you. The vague anxiety of &ldquo;am I healthy?&rdquo; is gone.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ════════ SCORING ════════ -->
    <section id="score" data-section="score" class="py-20 md:py-28 px-5">
      <div class="max-w-5xl mx-auto">
        <h2 class="section-reveal text-3xl md:text-4xl font-semibold tracking-tight text-apple-dark text-center text-balance">
          One score. Seven pillars.
        </h2>
        <p class="section-reveal mt-4 text-center text-apple-secondary text-[15px] md:text-base max-w-lg mx-auto">
          Your health score combines 50+ metrics across seven categories. Each compared against clinical ranges and your personal baselines.
        </p>
        <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3">
          <div class="section-reveal rounded-2xl bg-apple-gray p-4 text-center">
            <div class="w-8 h-8 bg-red-500 rounded-full mx-auto opacity-80"></div>
            <p class="mt-3 text-sm font-semibold text-apple-dark">Heart</p>
            <p class="mt-1 text-[11px] text-apple-secondary leading-snug">HR &middot; RHR &middot; HRV &middot; Recovery</p>
          </div>
          <div class="section-reveal rounded-2xl bg-apple-gray p-4 text-center" style="transition-delay:60ms">
            <div class="w-8 h-8 bg-indigo-500 rounded-full mx-auto opacity-80"></div>
            <p class="mt-3 text-sm font-semibold text-apple-dark">Sleep</p>
            <p class="mt-1 text-[11px] text-apple-secondary leading-snug">Duration &middot; Deep &middot; REM &middot; Core</p>
          </div>
          <div class="section-reveal rounded-2xl bg-apple-gray p-4 text-center" style="transition-delay:120ms">
            <div class="w-8 h-8 bg-green-500 rounded-full mx-auto opacity-80"></div>
            <p class="mt-3 text-sm font-semibold text-apple-dark">Activity</p>
            <p class="mt-1 text-[11px] text-apple-secondary leading-snug">Steps &middot; Calories &middot; Exercise &middot; Distance</p>
          </div>
          <div class="section-reveal rounded-2xl bg-apple-gray p-4 text-center" style="transition-delay:180ms">
