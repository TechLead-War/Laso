  <!-- ════════ CLIENT-SIDE SCRIPT ════════ -->
  <script>
    import { detectCountry, getPricing } from '../config/pricing'

    const APP_STORE_URL = 'https://apps.apple.com/app/laso/id0000000000' // ← replace

    // ── GA4 helper ──
    function trackEvent(name: string, params?: Record<string, string | number>) {
      if (typeof window.gtag === 'function') {
        window.gtag('event', name, params)
      }
    }

    // ── Dynamic pricing ──
    const country = detectCountry()
    const pricing = getPricing(country)

    const priceEl = document.getElementById('pro-price')
    const monthlyEl = document.getElementById('pro-monthly')
    if (priceEl) priceEl.textContent = pricing.yearlyDisplay
    if (monthlyEl) monthlyEl.textContent = pricing.monthlyEquivalent

    trackEvent('pricing_region_detected', {
      country: country ?? 'unknown',
      tier: pricing.tier,
      yearly_price: pricing.yearly,
    })

    // ── Download buttons ──
    document.querySelectorAll<HTMLElement>('[data-download]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const location = btn.dataset.download ?? 'unknown'
        trackEvent('download_click', { location })
        if (location.startsWith('pricing')) {
          const isPro = location.includes('pro')
          trackEvent('pricing_click', {
            plan: isPro ? 'pro_annual' : 'free',
            tier: isPro ? pricing.tier : 'free',
            price: isPro ? pricing.yearly : 0,
          })
        }
        window.open(APP_STORE_URL, '_blank', 'noopener')
      })
    })

    // ── Security: disable right-click & view-source shortcuts ──
    document.addEventListener('contextmenu', (e) => e.preventDefault())
    document.addEventListener('keydown', (e) => {
      const mod = e.ctrlKey || e.metaKey
      if (
        (mod && e.key === 'u') ||
        (mod && e.shiftKey && (e.key === 'I' || e.key === 'i')) ||
        (mod && e.shiftKey && (e.key === 'J' || e.key === 'j')) ||
        (mod && e.shiftKey && (e.key === 'C' || e.key === 'c')) ||
        (mod && e.key === 'Option') ||
        e.key === 'F12'
      ) {
        e.preventDefault()
      }
    })

    // ── Section reveal + visibility tracking ──
    const viewedSections = new Set<string>()
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const section = entry.target.getAttribute('data-section')
            if (section && !viewedSections.has(section)) {
              viewedSections.add(section)
              trackEvent('section_view', { section })
            }
          }
        })
      },
      { threshold: 0.15 },
    )

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible')
            revealObserver.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 },
    )

    document.querySelectorAll('[data-section]').forEach((s) => sectionObserver.observe(s))
    document.querySelectorAll('.section-reveal').forEach((el) => revealObserver.observe(el))

    // ── Score counter animation ──
    const counter = document.querySelector('.score-counter') as HTMLElement | null
    if (counter) {
      const target = parseInt(counter.dataset.target ?? '0', 10)
      let started = false
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true
            const duration = 1600
            const start = performance.now()
            const step = (now: number) => {
              const elapsed = now - start
              const progress = Math.min(elapsed / duration, 1)
              const eased = 1 - Math.pow(1 - progress, 3)
              counter.textContent = String(Math.round(eased * target))
              if (progress < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
            counterObserver.disconnect()
          }
        })
      }, { threshold: 0.5 })
      counterObserver.observe(counter)
    }

    // ── Scroll depth (25/50/75/100) ──
    const scrollFired = new Set<number>()
    window.addEventListener('scroll', () => {
      const pct = Math.round(((window.scrollY + window.innerHeight) / document.body.scrollHeight) * 100)
      for (const t of [25, 50, 75, 100]) {
        if (pct >= t && !scrollFired.has(t)) {
          scrollFired.add(t)
          trackEvent('scroll_depth', { depth: t })
        }
      }
    }, { passive: true })

    // ── Time on page ──
    const startTime = Date.now()
    window.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        const duration = Math.round((Date.now() - startTime) / 1000)
        if (typeof navigator.sendBeacon === 'function' && typeof window.gtag === 'function') {
          const params = new URLSearchParams({
            v: '2', tid: 'G-XXXXXXXXXX',
            en: 'time_on_page',
            'ep.duration_sec': String(duration),
          })
          navigator.sendBeacon(`https://www.google-analytics.com/g/collect?${params}`)
        }
        trackEvent('time_on_page', { duration_sec: duration })
      }
    })
  </script>
</Base>
