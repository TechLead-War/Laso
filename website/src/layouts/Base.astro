---
interface Props {
  title: string
  description: string
  jsonLd?: Record<string, unknown>[] | Record<string, unknown>
  keywords?: string
  ogImage?: string
}
const { title, description, jsonLd, keywords, ogImage } = Astro.props
const GA_ID = 'G-JQYL4TRHLQ'
const canonicalURL = new URL(Astro.url.pathname, 'https://lasohealth.fit')
const ogImageURL = ogImage ?? 'https://lasohealth.fit/og-image.jpg'
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Laso Health" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/apple-touch-icon.png" type="image/png" sizes="180x180" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- hreflang: one canonical English page serving all English-speaking markets.
       x-default is the fallback for any unmatched locale/region. -->
  <link rel="alternate" hreflang="en" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en-US" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en-GB" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en-IN" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en-CA" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en-AU" href={canonicalURL.href} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://us-central1-laso-health-v1.cloudfunctions.net" crossorigin />
  <noscript><style>.section-reveal{opacity:1!important;transform:none!important}</style></noscript>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Laso — Health Intelligence App" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Laso — Recovery score, strain tracking, sleep coaching, and health intelligence from your wearable" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content="Laso — Recovery score, strain tracking, sleep coaching, and health intelligence from your wearable" />

  <!-- Apple -->
  <!-- Smart App Banner: shows iOS Safari visitors the native "Open in App Store" bar for one-tap install. -->
  <meta name="apple-itunes-app" content="app-id=6762501313" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Laso" />

  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map((item) => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- GA4 -->
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script is:inline define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', GA_ID, { send_page_view: true });
  </script>

</head>
<body class="font-sans antialiased">
  <slot />
</body>
</html>
