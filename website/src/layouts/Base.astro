---
interface Props {
  title: string
  description: string
  jsonLd?: Record<string, unknown>[] | Record<string, unknown>
}
const { title, description, jsonLd } = Astro.props
const GA_ID = 'G-JQYL4TRHLQ'
const canonicalURL = new URL(Astro.url.pathname, 'https://lasohealth.fit')
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="health tracking app,recovery score app,apple watch recovery score,sleep tracking app,sleep debt tracker,strain tracking app,strain score,HRV tracking,HRV-based recovery,readiness score,fitness age app,vitality age,health metrics app,wellness pattern detection,overtraining detection,stress monitor app,wearable data analysis,on-device health analytics,private health tracking,HealthKit app,apple watch health app,oura alternative,whoop alternative app,garmin health analytics,sleep coaching app,health trend insights,fitness recovery app,workout recovery tracker,body composition tracker,VO2 max tracker,resting heart rate tracker,heart rate variability app,personal health baselines,health trend analysis,cycle tracking app,menstrual cycle training,Laso,Laso Health" />
  <meta name="author" content="Laso Health" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://us-central1-laso-health-v1.cloudfunctions.net" crossorigin />
  <noscript><style>.section-reveal{opacity:1!important;transform:none!important}</style></noscript>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Laso — Health Intelligence App" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content="https://lasohealth.fit/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Laso — Recovery score, strain tracking, sleep coaching, and health intelligence from your wearable" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@lasohealth" />
  <meta name="twitter:creator" content="@lasohealth" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://lasohealth.fit/og-image.png" />
  <meta name="twitter:image:alt" content="Laso — Recovery score, strain tracking, sleep coaching, and health intelligence from your wearable" />

  <!-- Apple -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Laso" />
  <!-- <meta name="apple-itunes-app" content="app-id=YOUR_APP_ID" /> -->

  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map((item) => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- GA4 -->
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script is:inline define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', GA_ID, { send_page_view: true });
  </script>

</head>
<body class="font-sans antialiased">
  <slot />
</body>
</html>
